# Database
DATABASE_URL=sqlite:./nilla.db

# JWT (本番では必ず強いランダム文字列に変更すること)
JWT_SECRET=replace-with-at-least-32-chars-local-dev-secret

# Google OAuth (console.cloud.google.com で取得)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (github.com/settings/developers で取得)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URLs
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ファイルストレージ
STORAGE_PATH=./uploads

# 静的ファイル配信 (本番ビルド時に dist/ を自動検出するため通常は不要)
# STATIC_DIR=./dist
