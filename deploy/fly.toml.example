app = "nilla-app-name"
primary_region = "nrt"

[build]
  dockerfile = "../infra/Dockerfile"
  ignorefile = "../.dockerignore"

[env]
  DATABASE_URL = "sqlite:/data/nilla.db"
  STORAGE_PATH = "/data/uploads"
  APP_URL = "https://nilla-app-name.fly.dev"
  FRONTEND_URL = "https://nilla-app-name.fly.dev"
  CORS_ORIGIN = "https://nilla-app-name.fly.dev"

[mounts]
  source = "nilla_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]
